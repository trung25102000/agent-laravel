aws_region                           = "ap-southeast-1"
aws_profile                          = "default"
s3_bucket_name                       = "seo-web-artifacts"
enable_codepipeline                  = false
codepipeline_name                    = "seo-web-pipeline"
codepipeline_role_arn                = "arn:aws:iam::123456789012:role/seo-web-codepipeline-role"
codepipeline_source_object_key       = "artifacts/seo-web.zip"
codepipeline_poll_for_source_changes = false
codedeploy_application_name          = "seo-web"
codedeploy_deployment_group_name     = "seo-web-production"
